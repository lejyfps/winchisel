<UserControl x:Class="Winchisel.DownloadsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="24" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Downloads" Style="{StaticResource TitleTextBlockStyle}"/><TextBlock Text="Find and install trusted applications with winget." Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel>
  <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <AutoSuggestBox x:Name="Search" PlaceholderText="Search apps, categories, or package IDs" QueryIcon="Find" TextChanged="Search_TextChanged"/>
   <ComboBox x:Name="Filter" Grid.Column="1" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" HorizontalAlignment="Stretch"><ComboBoxItem Content="All apps"/><ComboBoxItem Content="Installed"/><ComboBoxItem Content="Not installed"/></ComboBox>
   <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh" Click="Refresh_Click"/><Button x:Name="InstallButton" Grid.Column="3" Content="Install" Style="{StaticResource AccentButtonStyle}" Click="Install_Click" IsEnabled="False"/>
  </Grid>
  <StackPanel Grid.Row="2" Spacing="8"><ProgressBar x:Name="Loading" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Download operation progress"/><InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Assertive"/></StackPanel>
  <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Groups" Spacing="8"/></ScrollViewer>
 </Grid>
</UserControl>

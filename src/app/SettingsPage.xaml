<UserControl
    x:Class="Winchisel.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <StackPanel>
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Language, updates, and system protection."
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <Border Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Application" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ComboBox x:Name="Language" Header="Language" MinWidth="200" SelectionChanged="Language_SelectionChanged">
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="Deutsch" />
                    </ComboBox>
                    <ToggleSwitch x:Name="CheckUpdates" Header="Check for updates on startup" Toggled="Settings_Toggled" />
                    <ToggleSwitch x:Name="ShowConsole" Header="Show console" Toggled="Settings_Toggled" />
                    <ToggleSwitch x:Name="Autostart" Header="Start with Windows" Toggled="Settings_Toggled" />
                </StackPanel>
            </Border>
            <Border Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="System Protection" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Create restore point" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Repair" />
                        <Button Content="Disk cleanup" />
                        <Button Content="Temp files" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

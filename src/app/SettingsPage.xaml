<UserControl
    x:Class="Winchisel.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Keep the app behavior aligned with your workflow."
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Assertive" />

                    <TextBlock Text="Application" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="These settings are saved automatically."
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Language" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Choose the application language."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="Language"
                                      Grid.Column="1"
                                      MinWidth="160"
                                      VerticalAlignment="Center"
                                      SelectionChanged="Language_SelectionChanged">
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Deutsch" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="App theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Use the Windows theme or choose light or dark mode."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="Theme"
                                      Grid.Column="1"
                                      MinWidth="160"
                                      VerticalAlignment="Center"
                                      SelectionChanged="Theme_SelectionChanged">
                                <ComboBoxItem Content="System default" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Check updates on startup" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Look for a newer Winchisel release when the app starts."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CheckUpdates"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          Width="40"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Toggled="Settings_Toggled" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Show console" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Show the debug console window while the app is running."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowConsole"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          Width="40"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Toggled="Settings_Toggled" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Launch Winchisel automatically when you sign in."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="Autostart"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          Width="40"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Toggled="Settings_Toggled" />
                        </Grid>
                    </Border>

                    <TextBlock Text="System Protection" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="System Restore Point" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Create a rollback point before major system changes."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="RestoreButton"
                                    Grid.Column="1"
                                    Content="Create Restore Point"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="Restore_Click" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="System Repair" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Runs DISM and SFC to check and repair Windows component corruption."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="RepairButton"
                                    Grid.Column="1"
                                    Content="Run Repair"
                                    VerticalAlignment="Center"
                                    Click="Repair_Click" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Disk Cleanup - Run" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Runs Disk Cleanup on drive C: and removes old Windows updates."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="CleanupButton"
                                    Grid.Column="1"
                                    Content="Run"
                                    VerticalAlignment="Center"
                                    Click="Cleanup_Click" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Temporary Files - Remove" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Erase TEMP folders."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="TempButton"
                                    Grid.Column="1"
                                    Content="Remove"
                                    VerticalAlignment="Center"
                                    Click="Temp_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ProgressRing x:Name="Loading"
                          IsActive="False"
                          Width="48"
                          Height="48"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>

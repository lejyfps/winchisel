<UserControl
    x:Class="Winchisel.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Assertive" />

                    <TextBlock Text="Appearance" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="Choose how Winchisel looks and which language it uses."
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Language" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Choose the application language."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="Language"
                                      Grid.Column="1"
                                      MinWidth="160"
                                      VerticalAlignment="Center"
                                      SelectionChanged="Language_SelectionChanged">
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="Deutsch" />
                                <ComboBoxItem Content="Español" />
                                <ComboBoxItem Content="Français" />
                                <ComboBoxItem Content="Русский" />
                                <ComboBoxItem Content="简体中文" />
                                <ComboBoxItem Content="Português (Brasil)" />
                                <ComboBoxItem Content="Polski" />
                                <ComboBoxItem Content="Türkçe" />
                                <ComboBoxItem Content="日本語" />
                                <ComboBoxItem Content="한국어" />
                                <ComboBoxItem Content="Italiano" />
                                <ComboBoxItem Content="Nederlands" />
                                <ComboBoxItem Content="Українська" />
                                <ComboBoxItem Content="Čeština" />
                                <ComboBoxItem Content="Bahasa Indonesia" />
                                <ComboBoxItem Content="Tiếng Việt" />
                                <ComboBoxItem Content="العربية" />
                                <ComboBoxItem Content="繁體中文" />
                                <ComboBoxItem Content="ไทย" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                    <TextBlock Text="These settings are saved automatically."
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="App theme" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Use the Windows theme or choose light or dark mode."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="Theme"
                                      Grid.Column="1"
                                      MinWidth="160"
                                      VerticalAlignment="Center"
                                      SelectionChanged="Theme_SelectionChanged">
                                <ComboBoxItem Content="System default" />
                                <ComboBoxItem Content="Light" />
                                <ComboBoxItem Content="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Check updates on startup" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Look for a newer Winchisel release when the app starts."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CheckUpdates"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          Width="40"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Toggled="Settings_Toggled" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Show console" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Show the debug console window while the app is running."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowConsole"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          Width="40"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Toggled="Settings_Toggled" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Launch Winchisel automatically when you sign in."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="Autostart"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          Width="40"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Toggled="Settings_Toggled" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Risk Badges" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Show Safe, Moderate, and Risky badges next to tweaks."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RiskBadges"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          Width="40"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Toggled="Settings_Toggled" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="State Badges" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Show Recommended and Default state badges next to Performance tweaks."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StateBadges"
                                          Grid.Column="1"
                                          OnContent=""
                                          OffContent=""
                                          MinWidth="0"
                                          Width="40"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Toggled="Settings_Toggled" />
                        </Grid>
                    </Border>

                    <TextBlock Text="System Tools" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                    <TextBlock Text="Maintenance and recovery actions that run with administrator rights."
                               Style="{StaticResource CaptionTextBlockStyle}" />

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="System Restore Point" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Create a rollback point before major system changes."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="RestoreButton"
                                    Grid.Column="1"
                                    Content="Create Restore Point"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="Restore_Click" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="System Repair" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Runs DISM and SFC to check and repair Windows component corruption."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="RepairButton"
                                    Grid.Column="1"
                                    Content="Run Repair"
                                    VerticalAlignment="Center"
                                    Click="Repair_Click" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Disk Cleanup - Run" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Runs Disk Cleanup on drive C: and removes old Windows updates."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="CleanupButton"
                                    Grid.Column="1"
                                    Content="Run"
                                    VerticalAlignment="Center"
                                    Click="Cleanup_Click" />
                        </Grid>
                    </Border>

                    <Border Padding="16,12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Temporary Files - Remove" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Erase TEMP folders."
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                            <Button x:Name="TempButton"
                                    Grid.Column="1"
                                    Content="Remove"
                                    VerticalAlignment="Center"
                                    Click="Temp_Click" />
                        </Grid>
                    </Border>

                    <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
                    <Border Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="ms-appx:///assets/logo.png" Width="40" Height="40" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="Winchisel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="A fast, open-source Windows customization and optimization utility."
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="Licensed under GNU AGPL-3.0." Style="{StaticResource CaptionTextBlockStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Source code" Tag="https://github.com/lejyfps/winchisel" Click="Link_Click" />
                        <Button Content="Report a bug" Tag="https://github.com/lejyfps/winchisel/issues" Click="Link_Click" />
                        <Button Content="License" Tag="https://github.com/lejyfps/winchisel/blob/main/LICENSE" Click="Link_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ProgressBar x:Name="Loading"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Top"
                         AutomationProperties.Name="System operation progress" />
        </Grid>
    </Grid>
</UserControl>

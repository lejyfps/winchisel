<Window
    x:Class="Winchisel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Winchisel">

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8">
                <Image x:Name="AppTitleBarIcon" Width="24" Height="24" Stretch="Uniform" />
                <TextBlock x:Name="AppTitleText" Text="Winchisel" VerticalAlignment="Center"
                           FontFamily="Segoe UI Variable Text" FontSize="12" />
            </StackPanel>
            <StackPanel x:Name="TitleBarActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="2">
                <Button x:Name="UpdateButton" Click="Update_Click" Width="28" Height="28" Padding="0" CornerRadius="4" BorderThickness="0" FontSize="12" Background="Transparent"
                        ToolTipService.ToolTip="Check for updates" AutomationProperties.Name="Check for updates">
                    <Viewbox Width="10" Height="10"><SymbolIcon Symbol="Sync" /></Viewbox>
                </Button>
                <Button Click="BugReport_Click" Width="28" Height="28" Padding="0" CornerRadius="4" BorderThickness="0" FontSize="12"
                        Background="Transparent" Foreground="#E81123"
                        ToolTipService.ToolTip="Report a bug" AutomationProperties.Name="Report a bug">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#22E81123" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33E81123" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E81123" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E81123" />
                    </Button.Resources>
                    <Viewbox Width="10" Height="10"><SymbolIcon Symbol="ReportHacked" /></Viewbox>
                </Button>
                <Button Click="Donate_Click" Width="28" Height="28" Padding="0" CornerRadius="4" BorderThickness="0" FontSize="12" Background="Transparent"
                        ToolTipService.ToolTip="Donate" AutomationProperties.Name="Donate">
                    <Viewbox Width="10" Height="10"><SymbolIcon Symbol="Like" /></Viewbox>
                </Button>
            </StackPanel>
        </Grid>
    <NavigationView Grid.Row="1"
        x:Name="Nav"
        KeyboardAcceleratorPlacementMode="Hidden"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="256"
        CompactModeThresholdWidth="0"
        ExpandedModeThresholdWidth="0"
        IsPaneToggleButtonVisible="False"
        PaneDisplayMode="Left"
        SelectionChanged="Nav_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Home" Tag="home">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Debloater" Tag="debloater">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Delete" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Performance" Tag="performance">
                <NavigationViewItem.Icon><SymbolIcon Symbol="AllApps" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Privacy &amp; Security" Tag="privacy_security">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Permissions" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Downloads" Tag="downloads">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Download" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Processes" Tag="processes">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Contact" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Latency" Tag="latency">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Startup Manager" Tag="startup">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Scheduled Tasks" Tag="scheduled_tasks">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Calendar" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem Content="Extras" Tag="extras">
                <NavigationViewItem.Icon><SymbolIcon Symbol="More" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Settings" Tag="settings">
                <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>
        <Grid>
            <Frame x:Name="ContentFrame" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" />
            <InfoBar x:Name="ToastBar"
                     VerticalAlignment="Bottom"
                     HorizontalAlignment="Right"
                     Margin="24"
                     IsClosable="True"
                     IsOpen="False"
                     AutomationProperties.LiveSetting="Assertive" />
            <Border x:Name="UpdateStatusCard"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Margin="24"
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                <StackPanel Spacing="8" MinWidth="320">
                    <TextBlock x:Name="UpdateStatusText"
                               TextWrapping="Wrap"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ProgressBar x:Name="UpdateProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 IsIndeterminate="True"
                                 AutomationProperties.Name="Update download progress" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="UpdateRestartButton"
                                Content="Restart now"
                                Visibility="Collapsed"
                                Click="UpdateRestart_Click" />
                        <Button x:Name="UpdateLaterButton"
                                Content="Later"
                                Visibility="Collapsed"
                                Click="UpdateLater_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </NavigationView>
    </Grid>
</Window>

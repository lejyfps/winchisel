<UserControl
    x:Class="Winchisel.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Search" PlaceholderText="Search tweaks" QueryIcon="Find" TextChanged="Search_TextChanged" />
            <Button Grid.Column="1" Content="Recommended" Style="{StaticResource AccentButtonStyle}" Click="Recommended_Click" />
            <Button Grid.Column="2" Content="Defaults" Click="Defaults_Click" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="Groups" Spacing="8" />
            </Grid>
        </ScrollViewer>
        <InfoBar x:Name="ResultBar" Grid.Row="2" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Assertive" />
    </Grid>
</UserControl>

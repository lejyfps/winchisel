<UserControl
    x:Class="Winchisel.DebloaterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Debloater" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Remove or restore Windows apps, capabilities, and optional features."
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>

        <SelectorBar x:Name="Tabs" Grid.Row="1" SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem Text="Windows Apps" IsSelected="True" />
            <SelectorBarItem Text="Capabilities" />
            <SelectorBarItem Text="Optional Features" />
        </SelectorBar>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Search" PlaceholderText="Search" QueryIcon="Find" TextChanged="Search_TextChanged" />
            <ComboBox x:Name="Filter" Grid.Column="1" SelectedIndex="0" MinWidth="160" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Installed" />
                <ComboBoxItem Content="Not installed" />
            </ComboBox>
            <Button Grid.Column="2" Content="Refresh" Click="Refresh_Click" />
            <Button x:Name="InstallButton" Grid.Column="3" Content="Install" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" Click="Install_Click" />
            <Button x:Name="RemoveButton" Grid.Column="4" Content="Remove" IsEnabled="False" Click="Remove_Click" />
        </Grid>

        <Grid Grid.Row="3">
            <ListView x:Name="Items" SelectionMode="Multiple" SelectionChanged="Items_SelectionChanged" />
            <ProgressRing x:Name="Loading" IsActive="False" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <InfoBar x:Name="Notice" IsOpen="False" VerticalAlignment="Bottom" Margin="0,0,0,8" />
        </Grid>
    </Grid>
</UserControl>

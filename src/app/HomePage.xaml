<UserControl
    x:Class="Winchisel.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer Padding="24">
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Border Style="{StaticResource DashboardCard}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE770;" FontSize="18" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="System" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock x:Name="Board" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Bios" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
                <Border Grid.Column="1" Style="{StaticResource DashboardCard}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE950;" FontSize="18" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Processor" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock x:Name="CpuBrand" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CpuSub" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel></Grid></Border>
                <Border Grid.Row="1" Style="{StaticResource DashboardCard}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7F4;" FontSize="18" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Graphics" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock x:Name="GpuName" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="GpuVram" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel></Grid></Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardCard}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE964;" FontSize="18" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Memory" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock x:Name="MemValue" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="MemDetails" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
                <Border Grid.Row="2" Style="{StaticResource DashboardCard}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xEDA2;" FontSize="18" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Storage" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock x:Name="StorTotal" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="StorUsed" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel></Grid></Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource DashboardCard}"><Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7F8;" FontSize="18" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Windows" VerticalAlignment="Center"/><StackPanel Grid.Column="2"><TextBlock x:Name="OsVersion" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="OsBuild" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
            </Grid>

            <Grid ColumnSpacing="10" RowSpacing="10" Margin="0,4,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource DashboardCard}" MinHeight="126"><Grid><FontIcon Glyph="&#xE950;" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom" Spacing="6"><TextBlock Text="CPU usage"/><ProgressBar x:Name="CpuBar"/><TextBlock x:Name="CpuUsage" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel></Grid></Border>
                <Border Grid.Column="1" Style="{StaticResource DashboardCard}" MinHeight="126"><Grid><FontIcon Glyph="&#xE964;" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom" Spacing="6"><TextBlock Text="Memory usage"/><ProgressBar x:Name="MemBar"/><TextBlock x:Name="MemUsage" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel></Grid></Border>
                <Border Grid.Column="2" Style="{StaticResource DashboardCard}" MinHeight="126"><Grid><FontIcon Glyph="&#xEDA2;" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom" Spacing="6"><TextBlock Text="Storage usage"/><ProgressBar x:Name="StorBar"/><TextBlock x:Name="StorUsage" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/></StackPanel></Grid></Border>
                <Border Grid.Column="3" Style="{StaticResource DashboardCard}" MinHeight="126"><Grid><FontIcon Glyph="&#xE823;" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom" Spacing="4"><TextBlock Text="Uptime"/><TextBlock x:Name="Uptime" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
                <Border Grid.Row="1" Style="{StaticResource DashboardCard}" MinHeight="126"><Grid><FontIcon Glyph="&#xE9D9;" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom" Spacing="4"><TextBlock Text="Processes"/><TextBlock x:Name="ProcessCount" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardCard}" MinHeight="126"><Grid><FontIcon Glyph="&#xE950;" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom" Spacing="4"><TextBlock Text="Logical processors"/><TextBlock x:Name="CpuThreads" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DashboardCard}" MinHeight="126"><Grid><FontIcon Glyph="&#xE7F8;" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom" Spacing="4"><TextBlock Text="Display"/><TextBlock x:Name="Display" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
                <Border Grid.Row="1" Grid.Column="3" Style="{StaticResource DashboardCard}" MinHeight="126"><Grid><FontIcon Glyph="&#xE977;" FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel VerticalAlignment="Bottom" Spacing="4"><TextBlock Text="Computer"/><TextBlock x:Name="ComputerName" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl
    x:Class="Winchisel.ScheduledTasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox x:Name="Search" PlaceholderText="Search scheduled tasks" QueryIcon="Find" TextChanged="Search_TextChanged" />
            <ComboBox x:Name="SortBox" Grid.Column="1" MinWidth="140" VerticalAlignment="Center" SelectionChanged="SortBox_SelectionChanged" />
            <CheckBox x:Name="HideMicrosoft" Grid.Column="2" Content="Hide Microsoft entries" VerticalAlignment="Center" Checked="HideMicrosoft_Changed" Unchecked="HideMicrosoft_Changed" />
            <Button Grid.Column="3" Content="Refresh" Click="Refresh_Click" />
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="1" Text="Loading scheduled tasks..." Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <StackPanel x:Name="Items" Spacing="8" />
            </Grid>
        </ScrollViewer>
        <InfoBar x:Name="ResultBar" Grid.Row="3" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Assertive" />
    </Grid>
</UserControl>

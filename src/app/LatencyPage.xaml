<UserControl
    x:Class="Winchisel.LatencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Latency" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Analyze USB topology for latency issues."
                           Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
            <Button x:Name="AnalyzeButton" Content="Analyze" Style="{StaticResource AccentButtonStyle}"
                    Click="Analyze_Click" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0"
                         VerticalAlignment="Center" />
            <TextBlock x:Name="ProgressPercent" Grid.Column="1" Text="0%"
                       MinWidth="36" HorizontalTextAlignment="Right"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="2" Text="Ready" Style="{StaticResource CaptionTextBlockStyle}" />
        <Border Grid.Row="3" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer>
                <RichTextBlock x:Name="Report" TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                               LineHeight="20" LineStackingStrategy="BlockLineHeight" />
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

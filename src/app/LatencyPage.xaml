<UserControl
    x:Class="Winchisel.LatencyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Button x:Name="AnalyzeButton" Content="Analyze USB Latency" Style="{StaticResource AccentButtonStyle}"
                    Click="Analyze_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0"
                         VerticalAlignment="Center" />
            <TextBlock x:Name="ProgressPercent" Grid.Column="1" Text="0%"
                       MinWidth="36" HorizontalTextAlignment="Right"
                       Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>
        <TextBlock x:Name="Status" Grid.Row="2" Text="Ready" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite" />
        <Border Grid.Row="3" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer>
                <RichTextBlock x:Name="Report" TextWrapping="NoWrap" IsTextSelectionEnabled="True"
                               LineHeight="20" LineStackingStrategy="BlockLineHeight" />
            </ScrollViewer>
        </Border>
        <Expander x:Name="OptimizationsCard" Grid.Row="4" Header="Optimizations available"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  IsExpanded="False" Visibility="Collapsed">
            <StackPanel x:Name="OptimizationsList" Spacing="8" Padding="0,8,0,0" />
        </Expander>
    </Grid>
</UserControl>

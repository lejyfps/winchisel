<Application
    x:Class="Winchisel.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Winchisel">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="WindowCaptionBackground" Color="#1C1C1C" />
            <SolidColorBrush x:Key="WindowCaptionBackgroundDisabled" Color="#1C1C1C" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
